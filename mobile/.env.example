# Mobile runtime env (copy to .env locally — .env is gitignored).
#
# Read by mobile/app.config.ts via `dotenv/config` and exposed to the
# app through `Constants.expoConfig.extra.API_BASE / USE_MOCK`.

# Where the Expo app reaches the backend. Defaults to the Fly.io
# production deploy; override for local dev against a backend running
# on your laptop.
#   Prod (default): https://triaige-backend.fly.dev
#   Local LAN:      http://<your-laptop-lan-ip>:8000  (phone must be on same wifi)
#   iOS simulator:  http://localhost:8000
API_BASE=https://triaige-backend.fly.dev

# Swap to "true" to stub the API with the MSW test fixtures (offline
# demos / hermit development). `false` hits the real API_BASE above.
USE_MOCK=false

# Privacy policy + Terms of Service URLs the app links to from the
# Settings screen and from the store submission forms. Exposed as
# EXPO_PUBLIC_* so the values are inlined at bundle time (no runtime
# env lookup on client — resilient to airplane-mode settings views).
#
# These URLs are mandatory for App Store / Play Store submission.
# The pages are served by the dashboard (Next.js) at /privacy and
# /terms; both are Turkish + English (cookie-based locale switch).
# EXPO_PUBLIC_PRIVACY_URL=https://triaige.vercel.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://triaige.vercel.app/terms

# ── Sentry (mobile) ──
# Mobile DSN is PUBLIC by design — it lives in the client bundle.
# Sentry rate-limits by DSN, and the DSN is not a credential. Blank
# DSN disables Sentry entirely (the app still runs unchanged). Get
# the DSN from the `triaige-mobile-rn` project in Sentry.
# EXPO_PUBLIC_SENTRY_DSN=https://public_key@oXXXX.ingest.sentry.io/PROJECT_ID
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production   # or staging | development | test
# Defaults to app.config.ts `expo.version` if unset; set this in CI
# to a build-specific tag (e.g. `1.0.0+ios-42`) so Sentry can tie
# events to a single EAS build.
# EXPO_PUBLIC_SENTRY_RELEASE=
# 0.0–1.0 — fraction of traces sampled for performance monitoring.
# Defaults to 0.1 in production, 1.0 in dev.
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Sentry (EAS build — source map upload) ──
# These are used by the `@sentry/react-native/expo` config plugin at
# EAS build time to upload source maps. Never loaded at runtime,
# so they do NOT need the EXPO_PUBLIC_ prefix. Set as EAS secrets
# (`eas secret:create --name SENTRY_AUTH_TOKEN`) — the auth token
# grants write access to the Sentry project and must NOT ship to
# the client.
# SENTRY_AUTH_TOKEN=sntrys_xxx          # from Sentry Settings → Auth Tokens
# SENTRY_ORG=triaige                     # Sentry org slug
# SENTRY_PROJECT=triaige-mobile-rn       # Sentry project slug

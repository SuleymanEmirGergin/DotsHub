# Mobile runtime env (copy to .env locally — .env is gitignored).
#
# Read by mobile/app.config.ts via `dotenv/config` and exposed to the
# app through `Constants.expoConfig.extra.API_BASE / USE_MOCK`.

# Where the Expo app reaches the backend. Defaults to the Fly.io
# production deploy; override for local dev against a backend running
# on your laptop.
#   Prod (default): https://triaige-backend.fly.dev
#   Local LAN:      http://<your-laptop-lan-ip>:8000  (phone must be on same wifi)
#   iOS simulator:  http://localhost:8000
API_BASE=https://triaige-backend.fly.dev

# Swap to "true" to stub the API with the MSW test fixtures (offline
# demos / hermit development). `false` hits the real API_BASE above.
USE_MOCK=false

# Privacy policy + Terms of Service URLs the app links to from the
# Settings screen and from the store submission forms. Exposed as
# EXPO_PUBLIC_* so the values are inlined at bundle time (no runtime
# env lookup on client — resilient to airplane-mode settings views).
#
# These URLs are mandatory for App Store / Play Store submission.
# The pages are served by the dashboard (Next.js) at /privacy and
# /terms; both are Turkish + English (cookie-based locale switch).
# EXPO_PUBLIC_PRIVACY_URL=https://triaige.vercel.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://triaige.vercel.app/terms

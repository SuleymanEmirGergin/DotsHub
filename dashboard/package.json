{
  "name": "pretriage-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "lint:eslint": "eslint . --max-warnings=0",
    "test:routes": "node scripts/check_admin_proxy_contract.cjs",
    "test:i18n-contract": "node scripts/check_deployments_i18n_contract.cjs",
    "test:e2e": "playwright test --project=localhost",
    "test:e2e:ui": "playwright test --project=localhost --ui",
    "test:e2e:staging": "cross-env E2E_MODE=staging playwright test --project=staging",
    "test:e2e:staging:ui": "cross-env E2E_MODE=staging playwright test --project=staging --ui"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "9.19.0",
    "eslint-config-next": "15.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}

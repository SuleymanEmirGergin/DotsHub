# Live staging e2e credentials — copy to `.env.staging` and fill in.
# `.env.staging` is gitignored.  In CI, set each value as a GitHub
# Actions secret and pass it through the workflow's `env:` block.

# ── Deployed dashboard URL ───────────────────────────────────────────
# No trailing slash. Example: https://dashboard-staging.example.com
PLAYWRIGHT_BASE_URL=

# ── Staging Supabase project ─────────────────────────────────────────
STAGING_SUPABASE_URL=
# Public anon key — used by the dashboard's browser/authed clients.
STAGING_SUPABASE_ANON_KEY=
# Service role key — used by globalSetup/teardown + auth helpers only.
# NEVER commit or ship to the browser.
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# ── Test admin identity ──────────────────────────────────────────────
# Any real-looking address. globalSetup provisions the auth user +
# admin_users row idempotently. Pick a throwaway inbox.
STAGING_TEST_ADMIN_EMAIL=e2e-admin@example.test

# ── Switch ──────────────────────────────────────────────────────────
# Set by the pnpm scripts. Don't change manually unless debugging.
# E2E_MODE=staging

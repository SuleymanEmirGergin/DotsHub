{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus / Grafana Cloud scraping the Triaige /metrics endpoint.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dotshub pre-triage backend — HTTP health, capability-gate strips, rate-limit decisions, triage envelope mix, and confidence distribution. Sourced from prometheus_client counters declared in app/observability/metrics.py.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by status group (RPS)",
      "description": "Default instrumentation from prometheus-fastapi-instrumentator. Status groups (2xx/4xx/5xx) surface error spikes without touching high-cardinality status codes individually.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "description": "Latency percentiles from the HTTP histogram. p95 > 1s or p99 > 3s sustained → investigate.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Capability gate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Capability-gate strips per sec (by envelope type)",
      "description": "Responses where the capability gate stripped >=1 field. Sustained strip rate == chunk of user base on old client versions; plan a forced-update if this grows instead of decays.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] } },
      "targets": [
        {
          "expr": "sum by (envelope_type) (rate(capability_gate_filtered_total[$__rate_interval]))",
          "legendFormat": "{{envelope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bandwidth saved by capability gate (B/s)",
      "description": "Aggregate bytes removed from response bodies. Divide by http_requests_total rate to get avg bytes saved per req.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(capability_gate_bytes_saved_total[$__rate_interval])",
          "legendFormat": "bytes_saved/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Triage envelope mix",
      "description": "Distribution of envelope types emitted to reduced-capability clients. EMERGENCY spike = real signal (or rule regression); QUESTION stall = UX flow bug; ERROR growth = backend instability.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["sum"], "fields": "" },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] }
      },
      "targets": [
        {
          "expr": "sum by (envelope_type) (increase(triage_envelope_total[$__range]))",
          "legendFormat": "{{envelope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Confidence score distribution",
      "description": "Heatmap of confidence_score observations on RESULT envelopes. Flat histogram → tuning loss of signal; sharp peak at 0.5 → scoring plateau.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "calculate": false,
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "short" },
        "cellGap": 1,
        "color": { "scheme": "Spectral", "mode": "scheme", "exponent": 0.5, "steps": 32, "reverse": false }
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(confidence_score_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Rate limiting",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rate-limit decisions (allowed vs denied, per bucket)",
      "description": "Denied rate climbing == throttling pressure. Per-bucket splits isolate which surface is under load (default / admin / send_summary / llm_nlu).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/denied/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] } },
      "targets": [
        {
          "expr": "sum by (bucket, outcome) (rate(rate_limit_hits_total[$__rate_interval]))",
          "legendFormat": "{{bucket}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Denied fraction (all buckets)",
      "description": "Share of total rate-limit checks that hit the cap. Threshold tuning signal: <0.5% == over-provisioned, >5% sustained == user impact.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 35 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limit_hits_total{outcome=\"denied\"}[$__rate_interval])) / clamp_min(sum(rate(rate_limit_hits_total[$__rate_interval])), 1)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["triaige", "pretriage", "fastapi"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Triaige — Pretriage Backend",
  "uid": "triaige-pretriage",
  "version": 1,
  "weekStart": ""
}

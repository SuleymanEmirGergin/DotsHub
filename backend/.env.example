# ── LLM NLU — Wiro.ai / Gemini 2.5 Flash ─────────────────────────────────
# Uses the same WIRO_API_KEY below — no extra key needed.
LLM_NLU_ENABLED=false                  # set true to activate LLM extraction
LLM_PROVIDER=wiro                      # wiro | google | anthropic | openai
LLM_NLU_MODEL=google/gemini-2-5-flash  # Wiro model path
LLM_NLU_TIMEOUT_SECONDS=15.0           # hard deadline (submit + poll)
LLM_NLU_POLL_INTERVAL_SECONDS=0.5      # how often to poll Wiro for result
LLM_NLU_LOG_TO_SUPABASE=true
LLM_EXPLAIN_ENABLED=false
# LLM NLU rate limit (protects Wiro API quota — global server-side cap)
LLM_NLU_RATE_LIMIT_MAX_REQ=30          # max LLM NLU calls per window
LLM_NLU_RATE_LIMIT_WINDOW_SEC=60       # rolling window in seconds

# If using a non-Wiro provider, set LLM_API_KEY to that vendor's key:
# LLM_API_KEY=AIza...   # Google AI Studio
# LLM_API_KEY=sk-ant-...  # Anthropic

# ── Wiro (agent orchestration + NLU provider) ─────────────────────────────
# LLM Provider
WIRO_API_KEY=your_wiro_api_key
WIRO_API_SECRET=your_wiro_api_secret
LLM_MODEL=gpt-5-2
WIRO_BASE_URL=https://api.wiro.ai
WIRO_REASONING=medium
WIRO_WEB_SEARCH=false
WIRO_VERBOSITY=medium
WIRO_POLL_INTERVAL_SECONDS=1.0
WIRO_POLL_TIMEOUT_SECONDS=90.0
WIRO_HTTP_TIMEOUT_SECONDS=60.0

# Database (SQLite default for dev; use PostgreSQL for production)
# DATABASE_URL=postgresql+asyncpg://triaige:triaige_secret@localhost:5432/triaige
DATABASE_URL=sqlite+aiosqlite:///./triaige.db

# Supabase (for feedback & dashboard data)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Optional, recommended on IPv4-only networks where db.xxxx.supabase.co is IPv6-only
SUPABASE_DB_POOLER_URL=postgresql://postgres.xxxx:password@aws-0-REGION.pooler.supabase.com:6543/postgres
ADMIN_API_KEY=change_me

# Redis
REDIS_URL=redis://localhost:6379/0

# Facility discovery
FACILITY_DISCOVERY_ENABLED=false
FACILITY_DISCOVERY_TIMEOUT_SECONDS=2.5

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_FORMAT=json produces structured logs with request_id correlation.
# Any other value (or unset) uses the default plain-text format.
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Triage runtime tuning ──────────────────────────────────────────────────
# Confidence gate for RESULT top_conditions. Below this, Kaggle-derived
# candidates are dropped; curated entries are exempt. See
# backend/app/core/config.py comment for tuning semantics.
RESULT_TOP_CONDITIONS_GATE=0.25

# ── Mobile client version enforcement (M4) ─────────────────────────────────
# Surfaced via GET /v1/config/features. Mobile app compares its own
# Constants.expoConfig.version against MIN_CLIENT_VERSION and decides
# (based on CLIENT_VERSION_ENFORCEMENT) whether to stay silent, warn,
# or hard-block. Rolled as a feature flag so ops can bake "warn"
# before flipping "block" — see core/config.py for semantics.
#
#   off    — silent, ignore version mismatches (default; safe for dev)
#   warn   — non-blocking banner asking the user to update
#   block  — refuse to proceed; surface the store link
MIN_CLIENT_VERSION=0.0.0
LATEST_CLIENT_VERSION=0.0.0
CLIENT_VERSION_ENFORCEMENT=off
# Optional store deep links — blanks serialize as null in the payload.
CLIENT_VERSION_UPDATE_URL_IOS=
CLIENT_VERSION_UPDATE_URL_ANDROID=

# ── Rate-limit rejection monitor ──────────────────────────────────────────
# Rolling-window observer fires a webhook alert when rate-limit
# rejections cross the threshold. Useful for spotting abuse campaigns
# and legitimate traffic spikes that need the cap raised. Same WEBHOOK_*
# config as the LLM health / HTTP 5xx alerts.
RATE_LIMIT_ALERT_ENABLED=true
RATE_LIMIT_ALERT_WINDOW=100
RATE_LIMIT_ALERT_MIN_DECISIONS=30
RATE_LIMIT_ALERT_THRESHOLD_PCT=10.0
RATE_LIMIT_ALERT_COOLDOWN_SEC=600

# ── Sentry (error aggregation) ────────────────────────────────────────────
# If SENTRY_DSN is blank, the SDK is a no-op (dev/CI stay unchanged).
# Set to the prod / staging project DSN to enable aggregation.
#   traces_sample_rate: 0 = no perf traces (errors only)
#                       0.1 = sample 10% of requests (common prod default)
#                       1.0 = every request (dev / debugging only)
# Release: blank → SDK auto-detects from git SHA; set explicitly to pin.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# Override where runtime.py loads config/ from (emergency_rules.json,
# risk_rules.json). Default resolves config/ from the repo root via
# __file__. Set this only for deployments that relocate config.
# PRETRIAGE_CONFIG_DIR=/srv/pretriage/config

# ── Rate limits (general + admin + email) ──────────────────────────────────
# Triage/feedback endpoints (per IP, rolling window). Defaults below.
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX_REQ=20
# Admin API (per IP, stricter).
# ADMIN_RATE_LIMIT_WINDOW_SEC=60
# ADMIN_RATE_LIMIT_MAX_REQ=60
# Send-summary email (per IP, strict).
# SEND_SUMMARY_RATE_LIMIT_WINDOW_SEC=60
# SEND_SUMMARY_RATE_LIMIT_MAX_REQ=10

# ── Notifier webhooks (Slack / Discord) ────────────────────────────────────
# notifier.py posts EMERGENCY + HIGH-risk RESULT events here. Leave blank
# to disable; notifier gracefully no-ops when disabled.
WEBHOOK_ENABLED=false
# WEBHOOK_SLACK_URL=https://hooks.slack.com/services/...
# WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/...

# ── Grafana Cloud — Prometheus remote_write (production only) ─────────────
# Used by the Grafana Agent sidecar (see config/grafana-agent/config.river
# + docker-compose.observability.yml). Backend process itself never needs
# these — they live on the agent's env.
#
# Where to get them:
#   Grafana Cloud → My Account → Prometheus → "Sending metrics" page.
# Token scope: MetricsPublisher (minimum). Rule-write needs a broader
# token — see docs/OBSERVABILITY.md.
#
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-X.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROM_USER=1234567
# GRAFANA_CLOUD_PROM_TOKEN=glc_eyJvIjoi...
# DEPLOYMENT_ENV=production
# BACKEND_SCRAPE_TARGET=backend:8000   # override for non-default compose service name

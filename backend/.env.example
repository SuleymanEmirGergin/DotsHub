# ── LLM NLU — Wiro.ai / Gemini 2.5 Flash ─────────────────────────────────
# Uses the same WIRO_API_KEY below — no extra key needed.
LLM_NLU_ENABLED=false                  # set true to activate LLM extraction
LLM_PROVIDER=wiro                      # wiro | google | anthropic | openai
LLM_NLU_MODEL=google/gemini-2-5-flash  # Wiro model path
LLM_NLU_TIMEOUT_SECONDS=15.0           # hard deadline (submit + poll)
LLM_NLU_POLL_INTERVAL_SECONDS=0.5      # how often to poll Wiro for result
LLM_NLU_LOG_TO_SUPABASE=true
LLM_EXPLAIN_ENABLED=false
# LLM NLU rate limit (protects Wiro API quota — global server-side cap)
LLM_NLU_RATE_LIMIT_MAX_REQ=30          # max LLM NLU calls per window
LLM_NLU_RATE_LIMIT_WINDOW_SEC=60       # rolling window in seconds

# If using a non-Wiro provider, set LLM_API_KEY to that vendor's key:
# LLM_API_KEY=AIza...   # Google AI Studio
# LLM_API_KEY=sk-ant-...  # Anthropic

# ── Wiro (agent orchestration + NLU provider) ─────────────────────────────
# LLM Provider
WIRO_API_KEY=your_wiro_api_key
WIRO_API_SECRET=your_wiro_api_secret
LLM_MODEL=gpt-5-2
WIRO_BASE_URL=https://api.wiro.ai
WIRO_REASONING=medium
WIRO_WEB_SEARCH=false
WIRO_VERBOSITY=medium
WIRO_POLL_INTERVAL_SECONDS=1.0
WIRO_POLL_TIMEOUT_SECONDS=90.0
WIRO_HTTP_TIMEOUT_SECONDS=60.0

# Database (SQLite default for dev; use PostgreSQL for production)
# DATABASE_URL=postgresql+asyncpg://dotshub:dotshub_secret@localhost:5432/dotshub
DATABASE_URL=sqlite+aiosqlite:///./dotshub.db

# Supabase (for feedback & dashboard data)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Optional, recommended on IPv4-only networks where db.xxxx.supabase.co is IPv6-only
SUPABASE_DB_POOLER_URL=postgresql://postgres.xxxx:password@aws-0-REGION.pooler.supabase.com:6543/postgres
ADMIN_API_KEY=change_me

# Redis
REDIS_URL=redis://localhost:6379/0

# Facility discovery
FACILITY_DISCOVERY_ENABLED=false
FACILITY_DISCOVERY_TIMEOUT_SECONDS=2.5

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]
